NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
CORS_ORIGINS=

# Aiven PostgreSQL — ganti dengan Service URI dari dashboard Aiven.
# URL-encode karakter khusus pada password.
DATABASE_URL="postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require"

# Seed users
SEED_ADMIN_PASSWORD="ganti-password-super-admin"
SEED_DEMO_PASSWORD="ganti-password-user-demo"

# JWT & QR — wajib, minimal 16 karakter. Generate nilai acak yang kuat.
JWT_ACCESS_SECRET="ganti-dengan-string-acak-panjang"
JWT_REFRESH_SECRET="ganti-dengan-string-acak-panjang-lain"
QR_SECRET="ganti-dengan-string-acak-untuk-hmac-qr"

# Midtrans SANDBOX — wajib diisi saat Fase 7.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# SMTP — wajib diisi saat Fase 8.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EventTixx <no-reply@eventtixx.com>"
